{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/database.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "DatabaseService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/databases": {
      "get": {
        "summary": "ListDatabases 库实例列表（name 字典序；deleted tombstone 不进默认列表\n——与 apps 列表同口径）。",
        "operationId": "DatabaseService_ListDatabases",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDatabasesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "行数上限（缺省 100）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "project",
            "description": "项目收窄（v0.3 W2-S4 可见性过滤，rbac-teams §4.2）：裸名或 `team/project`\n限定形（D-W0-9 解析规则；解析域 = 调用方可见项目集，机具令牌/平台管理\n员 = 全库）。空 = 不收窄（用户面仍按可见项目集过滤）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      },
      "post": {
        "summary": "CreateDatabase 创建库实例（受理即 provisioning——无 created 态；凭据\n生成一次、age 密文落库；收敛器异步建现场过健康门 → ready）。",
        "operationId": "DatabaseService_CreateDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateDatabaseRequest"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}": {
      "get": {
        "summary": "GetDatabase 库实例详情（连接信息脱敏投影——密码明文零离开存储；显式\nreveal 面随 S4/S6 轮换与 Console 票据）。",
        "operationId": "DatabaseService_GetDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      },
      "delete": {
        "summary": "DeleteDatabase 删除受理（引用守卫通过后 → deleting tombstone 第一拍；\nreap duty 幂等清理受管对象。confirm = 实例名——数据安全两段式确认；\ndelete_volumes 默认 false = 卷保留转 orphaned，true = 删数据卷不可逆）。",
        "operationId": "DatabaseService_DeleteDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "confirm",
            "description": "破坏性确认 = 实例名原样回传（mismatch → 400——与卷-节点 409 前哨同\n型的数据安全面；引用 app 在册 → 409 E_DB_REFERENCED 先行）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "delete_volumes",
            "description": "删除数据卷（默认 false = 保留转 orphaned；true = 不可逆删除）。",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/backups": {
      "get": {
        "summary": "ListDatabaseBackups 备份台账列表（created_at 降序——恢复目标选择与\nConsole 备份列表的数据源；kind/snapshot/size/verify_status/error 全量\n事实面）。",
        "operationId": "DatabaseService_ListDatabaseBackups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDatabaseBackupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "行数上限（缺省 20）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      },
      "post": {
        "summary": "TriggerDatabaseBackup 手动备份受理（E4 S5，managed-databases §2.6）：\n异步受理（job 分钟级——响应即 accepted，结论经台账与 db.backup_* 事件\n披露；在途备份无台账行）。合法前置态 ready/degraded（§2.3 操作表）；\nper 实例操作互斥（备份/恢复/升级并发第二笔 → 409）。s3.mode=unset →\nE_S3_NOT_CONFIGURED（409——诚实拒绝，与注入前哨同码同语义）。",
        "operationId": "DatabaseService_TriggerDatabaseBackup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TriggerDatabaseBackupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceTriggerDatabaseBackupBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/credentials": {
      "get": {
        "summary": "RevealDatabaseCredentials 连接信息显式展开（admin scope；§2.5「Console\n库详情页展示连接信息，密码默认脱敏、显式展开」的 API 面——含密码明文\n与完整 URL；审计 db.reveal 承载敏感访问留痕，不产生事件）。",
        "operationId": "DatabaseService_RevealDatabaseCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RevealDatabaseCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/restore": {
      "post": {
        "summary": "RestoreDatabaseBackup 原地恢复受理（破坏性两段式 confirm + 快照归属\n守卫：只重放本实例台账内的快照）。停库重放：实例 scale 0 → job 挂卷\nrw 重放 → 重部署（异步——结论经 db.restore_* 事件披露；恢复中断 =\n实例保持停止 + E_DB_RESTORE_FAILED 事件的 critical 口径，§2.6）。",
        "operationId": "DatabaseService_RestoreDatabaseBackup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RestoreDatabaseBackupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceRestoreDatabaseBackupBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/resume": {
      "post": {
        "summary": "ResumeDatabase 恢复（paused → provisioning 重收敛 → ready/degraded）。",
        "operationId": "DatabaseService_ResumeDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ResumeDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceResumeDatabaseBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/retry": {
      "post": {
        "summary": "RetryDatabase 显式重试（failed → provisioning 重收敛；现场保留语义下\n失败的唯一出边）。",
        "operationId": "DatabaseService_RetryDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RetryDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceRetryDatabaseBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/rotate": {
      "post": {
        "summary": "RotateDatabaseCredentials 凭据轮换（E4 managed-databases §2.5，S4）：\n破坏性两段式（confirm = 实例名）。合法前置态 ready/degraded/paused\n（§2.3 操作表；PG 暂停期拒绝——postgres 需运行中实例才能 ALTER USER，\n如实报 409 并提示先 resume）。引擎侧成功后：引用方 system 物化行回\npending + 平台自动触发全部引用 app 重部署（各自走正常部署队列）。",
        "operationId": "DatabaseService_RotateDatabaseCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RotateDatabaseCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceRotateDatabaseCredentialsBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/settings": {
      "put": {
        "summary": "UpdateDatabaseSettings 设置变更（限额 + 备份计划；任意非终态准入、主\n状态不变；限额变更 = spec 重建由收敛器在下一拍承载）。镜像/引擎参数\n受管（违规模板字段不存在于请求——E_DB_TEMPLATE_UNSUPPORTED 面）。",
        "operationId": "DatabaseService_UpdateDatabaseSettings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateDatabaseSettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceUpdateDatabaseSettingsBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/suspend": {
      "post": {
        "summary": "SuspendDatabase 暂停（scale 0 保留服务与卷；引用方连不上是诚实暴露）。",
        "operationId": "DatabaseService_SuspendDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SuspendDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceSuspendDatabaseBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    },
    "/v1/databases/{name}/upgrade": {
      "post": {
        "summary": "UpgradeDatabase 受控升级受理（E4 S5，managed-databases §2.2）：①\npre_upgrade 备份门（verify 通过才继续——失败实例不动）②digest 换新\n受控重建 ③健康门 ④失败 = digest 归位 + db.upgrade_failed + 状态落\ndegraded。异步受理（备份门与健康门是分钟级）；paused = 仅换 spec 不\n重启（resume 时以新版本重建）。合法前置态 ready/degraded/paused。",
        "operationId": "DatabaseService_UpgradeDatabase",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpgradeDatabaseResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DatabaseServiceUpgradeDatabaseBody"
            }
          }
        ],
        "tags": [
          "DatabaseService"
        ]
      }
    }
  },
  "definitions": {
    "DatabaseServiceRestoreDatabaseBackupBody": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "title": "恢复目标（restic snapshot 标识——必须在本实例台账内，跨实例误指 422）。"
        },
        "confirm": {
          "type": "string",
          "title": "破坏性确认 = 实例名原样回传（mismatch → 400——原地重放覆盖数据卷上\n的现库，与 DeleteDatabase 同型的数据安全面）。"
        }
      }
    },
    "DatabaseServiceResumeDatabaseBody": {
      "type": "object"
    },
    "DatabaseServiceRetryDatabaseBody": {
      "type": "object"
    },
    "DatabaseServiceRotateDatabaseCredentialsBody": {
      "type": "object",
      "properties": {
        "confirm": {
          "type": "string"
        }
      },
      "title": "RotateDatabaseCredentialsRequest 是凭据轮换受理（破坏性两段式：confirm =\n实例名原样回传，mismatch → 400——与 DeleteDatabase 同型的数据安全面）。"
    },
    "DatabaseServiceSuspendDatabaseBody": {
      "type": "object"
    },
    "DatabaseServiceTriggerDatabaseBackupBody": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "title": "备份类别（缺省 manual；API 面只受理 manual——daily/pre_upgrade 是平台\n调度与升级门的内部类别）。"
        }
      }
    },
    "DatabaseServiceUpdateDatabaseSettingsBody": {
      "type": "object",
      "properties": {
        "limits": {
          "$ref": "#/definitions/v1DatabaseLimits",
          "title": "资源限额（零值字段回落模板缺省；limits 变更 = spec 重建由收敛器承载）。"
        },
        "backup_plan": {
          "$ref": "#/definitions/v1DatabaseBackupPlan",
          "title": "备份计划（备份调度执行体随 S5 票据；本面先行受理与展示）。"
        }
      }
    },
    "DatabaseServiceUpgradeDatabaseBody": {
      "type": "object",
      "properties": {
        "confirm": {
          "type": "string",
          "title": "破坏性确认 = 实例名原样回传（mismatch → 400——受控重建有停机窗口，\n且失败路径触发 digest 归位重建）。"
        }
      }
    },
    "v1CreateDatabaseRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "库实例名（^[a-z0-9][a-z0-9_-]*$——与 app 名同字符集规则；对象前缀族\nfleetly-db-* 与 app 名族解耦，app 与库实例可重名）。project 内唯一\n（D-W0-4 二修——跨项目同名实例合法）。"
        },
        "template": {
          "type": "string",
          "title": "模板 ID（平台内置注册表：postgres-16 / postgres-18 /\npercona-postgresql-18 / redis-7 / mysql-8.4 / mongodb-8.0；未知 → 400）。\n**大版本升级不做**（创建时钉死）：升 major = dump/restore 到新实例；\nminor 由镜像 digest 钉定、随平台 release 以同卷受控重建演进\n（UpgradeDatabase）。"
        },
        "limits": {
          "$ref": "#/definitions/v1DatabaseLimits",
          "title": "资源限额（零值字段回落模板缺省——PG 1C/1Gi、Redis 0.5C/256Mi、\nMySQL/Mongo 1C/1Gi）。"
        },
        "backup_plan": {
          "$ref": "#/definitions/v1DatabaseBackupPlan",
          "title": "备份计划（零值字段回落平台缺省 24h/7 份/03:00 UTC）。"
        },
        "project": {
          "type": "string",
          "title": "目标项目（v0.3 W2-S3 归属管道，D-W0-9 解析规则）：裸名或\n`team/project` 限定形；解析规则与缺省语义同 DeployRequest.project\n（机具令牌必须显式）。首次创建写入 db_instances.project_id/team_id；\n行上归属已定时必须一致（409 E_APP_PROJECT_MISMATCH 指引 MoveDatabase）。"
        }
      }
    },
    "v1CreateDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        }
      }
    },
    "v1DatabaseBackupPlan": {
      "type": "object",
      "properties": {
        "interval_hours": {
          "type": "integer",
          "format": "int32"
        },
        "keep": {
          "type": "integer",
          "format": "int32"
        },
        "hour_utc": {
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "DatabaseBackupPlan 是备份计划（§5.4 配置键 databases.backup_* 的 per\n实例覆盖；0 值字段 = 平台缺省）。"
    },
    "v1DatabaseBackupView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "备份类别（daily|manual|pre_upgrade）。"
        },
        "snapshot": {
          "type": "string",
          "title": "restic repo 内 snapshot 标识（db/\u003cinstance\u003e/ 命名空间寻址，非文件路径）。"
        },
        "size_bytes": {
          "type": "string",
          "format": "int64",
          "title": "导出流字节量（0 = 未记录）。"
        },
        "verify_status": {
          "type": "string",
          "title": "回读校验状态（unverified|verified|failed——「备份假成功」零容忍）。"
        },
        "error": {
          "type": "string",
          "title": "失败/校验失败原因摘要（单行；凭据材料零出现）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "DatabaseBackupView 是一行备份台账投影（§2.6 台账裁决的全量事实面）。"
    },
    "v1DatabaseConnectionView": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "user": {
          "type": "string",
          "title": "PG 有 user/database；Redis 不输出（0 值 + 空串在 EmitUnpopulated=false\n下不出现）。"
        },
        "database": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "title": "掩码 URL（postgres://fleetly:********@\u003chost\u003e:5432/\u003cdb\u003e / redis://:********@\u003chost\u003e:6379/0）。"
        },
        "password_fingerprint": {
          "type": "string",
          "title": "密码指纹（sha256 前 8 hex——只判「是不是那个值」，材料零出现）。"
        }
      },
      "title": "DatabaseConnectionView 是连接信息脱敏投影（§2.5 键集的只读面）。url 中\n密码段恒为固定掩码（********）——明文零离开存储；host = 实例名 DNS 别名\n（引用方 app 内即以此可达）。"
    },
    "v1DatabaseLimits": {
      "type": "object",
      "properties": {
        "cpu_seconds": {
          "type": "number",
          "format": "double",
          "title": "CPU 限额（核数；0 = 模板缺省）。"
        },
        "memory_bytes": {
          "type": "string",
          "format": "int64",
          "title": "内存限额（字节；0 = 模板缺省）。"
        }
      },
      "title": "DatabaseLimits 是资源限额（仅 limits——镜像/引擎参数受管）。"
    },
    "v1DatabaseView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "生命周期状态位（provisioning|ready|failed|degraded|paused|deleting|deleted）。"
        },
        "placement": {
          "type": "string",
          "title": "放置绑定（平台节点 ID；空 = 未绑定——provisioning 首拍前）。"
        },
        "volume": {
          "$ref": "#/definitions/v1DatabaseVolumeView",
          "title": "数据卷投影（name = docker 卷名；status = active|orphaned|discarded；\n空 = 尚未登记）。"
        },
        "connection": {
          "$ref": "#/definitions/v1DatabaseConnectionView",
          "title": "连接信息脱敏投影。"
        },
        "backup_plan": {
          "$ref": "#/definitions/v1DatabaseBackupPlan"
        },
        "limits": {
          "$ref": "#/definitions/v1DatabaseLimits"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "credential_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_error": {
          "type": "string",
          "title": "最近一次收敛失败原因（failed/deleting 前的现场快照；空 = 无失败现场）。"
        },
        "upgrade_available": {
          "type": "boolean",
          "title": "可升级位（E4 S5，§2.2 升级语义）：instance.image_digest ≠ 模板当前钉\n定镜像 = true（升级逐实例 opt-in——既有实例不自动变）。"
        }
      },
      "title": "DatabaseView 是库实例投影（状态 = 生命周期态；连接信息脱敏——密码明文\n零离开存储，url 已掩码、password_fingerprint 供「是不是那个 secret」比\n对；显式 reveal 面随 S4/S6）。last_error 是最近一次收敛失败原因（failed\n诊断面；'' = 无失败现场）。"
    },
    "v1DatabaseVolumeView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "platform_node_id": {
          "type": "string",
          "title": "数据节点（卷钉住语义——与 placement 一致）。"
        }
      }
    },
    "v1DeleteDatabaseResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        }
      }
    },
    "v1ListDatabaseBackupsResponse": {
      "type": "object",
      "properties": {
        "backups": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DatabaseBackupView"
          }
        }
      }
    },
    "v1ListDatabasesResponse": {
      "type": "object",
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DatabaseView"
          }
        }
      }
    },
    "v1RestoreDatabaseBackupResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "恒为 \"accepted\"。"
        }
      },
      "title": "异步受理响应：停库重放分钟级——结论经 db.restore_completed /\ndb.restore_failed 事件与实例 last_error 披露；恢复中断 = 实例保持停止\n（人工 runbook 随事件/错误文本）。"
    },
    "v1ResumeDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        }
      }
    },
    "v1RetryDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        }
      }
    },
    "v1RevealDatabaseCredentialsResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "user": {
          "type": "string",
          "title": "PG 有 user/database；Redis 不输出（空串）。"
        },
        "database": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "title": "密码明文（显式展开面的设计内例外；凭据字符集 [a-zA-Z0-9]）。"
        },
        "url": {
          "type": "string",
          "title": "标准 URI（密码段为明文——与 GetEnv 明文读同级的 admin 面）。"
        }
      },
      "title": "RevealDatabaseCredentialsResponse 是连接信息的显式展开投影（§2.5 键集\n全量 + 密码明文——admin scope 专用面；值只出现在本响应，不进日志/事件/\n审计，审计 db.reveal 只记访问事实）。"
    },
    "v1RotateDatabaseCredentialsResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        },
        "redeployed_apps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "平台自动重部署的引用 app 名单（各自走正常部署队列；credential_updated_at\n展示随 database.credential_updated_at 刷新）。"
        }
      }
    },
    "v1SuspendDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        }
      }
    },
    "v1TriggerDatabaseBackupResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "恒为 \"accepted\"。"
        }
      },
      "title": "异步受理响应：job 分钟级——结论经台账（ListDatabaseBackups）与\ndb.backup_succeeded / db.backup_failed 事件披露；在途备份无台账行。"
    },
    "v1UpdateDatabaseSettingsResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        }
      }
    },
    "v1UpgradeDatabaseResponse": {
      "type": "object",
      "properties": {
        "database": {
          "$ref": "#/definitions/v1DatabaseView"
        },
        "status": {
          "type": "string",
          "title": "恒为 \"accepted\"。"
        }
      },
      "title": "异步受理响应：备份门与健康门是分钟级——结论经 db.upgrade_started/\nfinished/failed 事件披露。view = 受理时刻投影（upgrade_available 尚为\ntrue；digest 切换随编排推进）。"
    }
  }
}
