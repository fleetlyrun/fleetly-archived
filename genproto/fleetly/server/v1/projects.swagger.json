  "paths": {
    "/v1/apps/{app}/project-network": {
      "delete": {
        "summary": "DetachAppProjectNetwork 从项目网摘除 app（摘网随下一次重部署的服务\n滚动收敛；项目网在失去最后一名成员且零端点后由平台回收）。权限与\n在途守卫同 Attach。",
        "operationId": "ProjectsService_DetachAppProjectNetwork",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DetachAppProjectNetworkResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ProjectsService"
        ]
      },
      "post": {
        "summary": "AttachAppProjectNetwork 把 app 挂入其项目网（T 线 OT-1 / IMPL-T15-1 的\n显式 opt-in；项目由 app 行归属解析——请求不携带项目，避免「指向别的\n项目网」的歧义面）。语义（全部幂等）：\n  1. 确保项目网 overlay 在位（平台建 `fleetly-project-\u003cproject_id\u003e`，\n     带自描述 label；缺失创建、已存在不覆盖）；\n  2. 参与位置位（状态库唯一改变路径；审计 app.project_network_attached\n     + 事件 project.network_changed 同事务）；\n  3. 入队「参与变更重部署」（复用最近 succeeded 部署的 compose——新\n     revision 的成员服务双挂项目网，滚动收敛；无部署史 = 仅置位）。\n权限：admin scope + 项目角色 admin（网络姿态改变是隔离面的敏感写，\n与 app 删除/secrets 同级；平台管理员只读不代写）。在途部署存在时 409\n拒绝（重部署会以旧快照覆盖在途发布）。",
        "operationId": "ProjectsService_AttachAppProjectNetwork",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AttachAppProjectNetworkResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ProjectsService"
        ]
      }
    },
    "/v1/projects": {
      "get": {
        "summary": "ListProjects 我可见项目（团队归属集）；带 team_id 收窄到单队（须为\n该队成员或平台管理员）；平台管理员不带过滤 = 全部。",
        "operationId": "ProjectsService_ListProjects",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListProjectsResponse"
            }
