    "/v1/projects/{to_project_id}:move-app": {
      "post": {
        "summary": "MoveApp 资源改派（v0.3 W2-S3，rbac-teams §3.4/§5；平台管理员专属）：\n写归属 + 换名重部署（D-W0-4 二修——底座命名三段以归属为参数）。无卷\n服务近零中断（建新名→等 running→删旧名）；有卷短暂停机窗口。跨团队/\n跨项目改派先过目标项目唯一性（409）。app 引用 = 裸名（解析域内唯一）\n或 `team/prj/app` 限定形或平台 ID；目标项目 = 平台 ID（D-W0-9：管理面\n用 ID，免疫重名）。",
        "operationId": "ProjectsService_MoveApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1MoveAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "to_project_id",
            "description": "目标项目平台 ID（管理面用 ID，D-W0-9——免疫同名项目歧义）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ProjectsServiceMoveAppBody"
            }
          }
        ],
        "tags": [
          "ProjectsService"
        ]
      }
    },
