        },
        "target_mem_pct": {
          "type": "integer",
          "format": "int32",
          "title": "内存目标水位百分数（[20,90]；0 = 未设该维度目标）。"
        },
        "cooldown_seconds": {
          "type": "integer",
          "format": "int32",
          "title": "动作冷却窗秒数（[60,3600]，缺省 180）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
