    "/v1/apps/{name}/resume": {
      "post": {
        "summary": "ResumeApp 恢复应用（app Start；admin 门）：清挂起位并入队 active\nrevision 的重部署（重放快照走正常发布管线恢复副本——响应带\ndeployment_id 供跟踪；应用从无成功部署时无物可恢复，deployment_id\n为空且清位照常生效）。",
        "operationId": "AppsService_ResumeApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ResumeAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "应用名（裸名/限定形，resolveApp 单点解析）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceResumeAppBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/scaling/{service}": {
      "get": {
        "summary": "GetScalingPolicy 读取服务的自动扩缩策略（W5-S1，D-V3W5-2；read 门——\n策略是应用运行面的事实视图）。未设置返回 404（未配置即无策略）。",
        "operationId": "AppsService_GetScalingPolicy",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetScalingPolicyResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "应用名（裸名/限定形，resolveApp 单点解析）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "service",
            "description": "compose 服务名。",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      },
      "delete": {
        "summary": "RemoveScalingPolicy 删除服务的自动扩缩策略（deploy 门）。同键运行期\n副本覆盖一并清除——期望副本回落 compose 快照（外部改动照常走漂移判据）。",
        "operationId": "AppsService_RemoveScalingPolicy",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RemoveScalingPolicyResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "service",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      },
      "put": {
        "summary": "SetScalingPolicy 写入（整行替换 upsert）服务的自动扩缩策略（deploy 门\n——资源面写语义，与 Deploy/SetEnv 同级；用户 principal 另受项目角色门\n约束，机具令牌 admin 等价照旧）。约束：min ≥1、max ≤16、target ∈\n[20,90]（0 = 该维度不设目标，至少一维必设）、cooldown ∈ [60,3600]s\n缺省 180。生效前置：metrics.mode=on 且服务 running（metrics off 时\n策略休眠——scaling.dormant 事件一次性披露）；有卷服务只扩不缩。",
        "operationId": "AppsService_SetScalingPolicy",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetScalingPolicyResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "service",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceSetScalingPolicyBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/source": {
      "put": {
        "summary": "SetAppSource 设置 webhook 拉源配置（remote url + 分支 + 认证形态；\nadmin）。source_branch 同时是 git push 的触发分支（app 配置分支，\n默认 main）。\n认证材料（https_token/ssh_key）经平台 envelope 加密落库，引用不落明文。",
        "operationId": "AppsService_SetAppSource",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetAppSourceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceSetAppSourceBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/suspend": {
      "post": {
        "summary": "SuspendApp 挂起应用（app Stop；admin 门，与 SuspendDatabase 同级——\n整应用停摆是大爆炸半径动作）。权威位翻转（apps.suspended，API 只转\n位）——引擎周期对账随后把受管长驻服务排水到副本 0（服务对象保留，\n引用方连不上是诚实暴露）；cron 调度/手动触发、部署入队、drift、\nautoscaler 挂起期按位豁免。重复挂起 409（幂等面由读面投影消化）。",
        "operationId": "AppsService_SuspendApp",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SuspendAppResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "应用名（裸名/限定形，resolveApp 单点解析）。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceSuspendAppBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/webhook": {
      "get": {
        "summary": "ShowAppWebhook 回读 webhook/git 触发配置（无敏感投影：secret 只回\nconfigured 位；admin scope——source URL 与分支拓扑属运维面）。",
        "operationId": "AppsService_ShowAppWebhook",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ShowAppWebhookResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
    "/v1/apps/{name}/webhook-secret": {
      "put": {
        "summary": "SetAppWebhookSecret 设置 per-app webhook 签名密钥（T2.19；admin）。\n值经平台 envelope 加密落库（明文不落），show 面只回 configured 位。\n未配置 = webhook 端点未启用（404 语义）。",
        "operationId": "AppsService_SetAppWebhookSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetAppWebhookSecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "应用名。",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AppsServiceSetAppWebhookSecretBody"
            }
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    }
  },
  "definitions": {
    "AppsServiceResumeAppBody": {
      "type": "object"
    },
    "AppsServiceSetAppSourceBody": {
      "type": "object",
      "properties": {
        "source_url": {
          "type": "string",
          "title": "拉源 remote URL（file:// 与 https://、ssh:// 形态）。"
        },
        "source_branch": {
          "type": "string",
          "title": "app 配置分支（默认 main）：push 触发与 webhook 拉取共用此分支。"
        },
        "source_auth_kind": {
          "type": "string",
          "title": "认证形态：none | https_token | ssh_key。"
        },
        "source_auth_secret": {
          "type": "string",
          "title": "认证材料（https_token = token 原文；ssh_key = PEM 私钥）。source_auth_kind =\nnone 时必须为空；服务端 envelope 加密落库，明文不落、永不回读。\nprotovalidate 形状约束在服务端用例层按 source_auth_kind 交叉校验（跨字段\n规则—— CEL 交叉字段此处不引入，保持 proto 面最小）。"
        }
      }
    },
    "AppsServiceSetAppWebhookSecretBody": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "title": "webhook 签名密钥（HMAC-SHA256 原料，GitHub/Gitea 同形态）。≥16 字符\n——弱密钥显式拒绝（验签是该端点的唯一认证）。"
        }
      }
    },
    "AppsServiceSetScalingPolicyBody": {
      "type": "object",
      "properties": {
        "min_replicas": {
          "type": "integer",
          "format": "int32",
          "title": "副本下限（≥1；必填）。"
        },
        "max_replicas": {
          "type": "integer",
          "format": "int32",
          "title": "副本上限（≤16 且 ≥ min；必填）。"
        },
        "target_cpu_pct": {
          "type": "integer",
          "format": "int32",
          "title": "CPU 目标水位（0 = 不设该维度；至少一维非 0）。"
        },
        "target_mem_pct": {
          "type": "integer",
          "format": "int32",
          "title": "内存目标水位（0 = 不设该维度；至少一维非 0）。"
        },
        "cooldown_seconds": {
          "type": "integer",
          "format": "int32",
          "title": "冷却窗秒数（0 = 缺省 180）。"
        }
      }
    },
    "AppsServiceSuspendAppBody": {
      "type": "object"
    },
    "v1AppView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string",
          "title": "生命周期状态位：active / deleting / deleted。"
        },
        "derived_state": {
          "type": "string",
          "title": "派生状态：running / degraded / blocked / down / suspended（读面即时\n推导；suspended = 用户挂起位的直投影，不是对底座的观察结论）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "team_slug": {
          "type": "string",
          "title": "归属 slug（v0.3 W2-S3 归属模型；Console 限定形展示与团队级收窄过滤\n的数据源——此前无归属投影，同名 app 在列表面不可分）。"
        },
        "project_slug": {
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "title": "归属项目平台 ID（IMPL-T15-1：项目详情链接与项目网操作的目标锚；\n管理面用 ID，免疫跨团队同名项目歧义）。"
        },
        "project_network_attached": {
          "type": "boolean",
          "title": "项目网参与状态（IMPL-T15-1/OT-1 显式 opt-in）：attached=true 时\nproject_network = 项目网 overlay 名（`fleetly-project-\u003cproject_id\u003e`），\n成员服务在 app 私网之外双挂该网（项目网别名 `\u003capp\u003e-\u003cservice\u003e`）；\n缺省 false = 不参加（既有 app 私网隔离现状）。"
        },
        "project_network": {
          "type": "string"
        },
        "suspended": {
          "type": "boolean",
          "title": "挂起位（app Stop/Start）：true = 用户请求停止——受管长驻服务副本被\n引擎排水到 0（服务对象保留），部署入队/drift/autoscaler/cron 挂起期\n按位豁免。恢复 = resume（清位 + active revision 重部署）。"
        }
      }
    },
    "v1DeleteAppResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string",
          "title": "删除推进后的生命周期位（active → deleting）。"
        }
      }
    },
    "v1DeploymentView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "deploy | rollback。"
        },
        "status": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "title": "子状态（blocked_waiting 或空）。"
        },
        "revision_id": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "recovery": {
          "type": "string",
          "title": "同记录恢复记录（replay | blocked；空 = 无）。"
        },
        "substrate_halted": {
          "type": "boolean",
          "title": "首发失败 scale=0 保留现场。"
        },
        "first_healthy_at": {
          "type": "string",
          "format": "date-time"
        },
        "downtime_ms": {
          "type": "string",
          "format": "int64"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_git_sha": {
          "type": "string",
          "title": "git 触发来源（T2.19）：仅经 git push(SSH)/webhook 入队（DeployFromGit\n路径）的部署非空——sha 为 40 位 commit、ref 为 refs/heads/\u003cbranch\u003e；\nAPI/CLI 直传 compose 的部署为空（EmitUnpopulated=false 语义下不输出）。\nwebhook 入口的 (app, sha) 幂等去重即以此字段为判据，读面回显供\nAI-Agent/运营核对「这次部署来自哪个 commit」。"
        },
        "source_git_ref": {
          "type": "string"
        }
      },
      "title": "DeploymentView 是部署状态机行的只读投影（词表与 state 层一致：\nqueued/preparing/building/releasing/observing/succeeded/failed/cancelled）。"
    },
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetAppResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "derived_state": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "team_slug": {
          "type": "string",
          "title": "归属 slug（AppView 同款；详情头与列表行的限定形展示同源）。"
        },
        "project_slug": {
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "title": "归属项目平台 ID 与项目网参与投影（IMPL-T15-1；AppView 同款字段，\n详情页的项目网卡数据源）。"
        },
        "project_network_attached": {
          "type": "boolean"
        },
        "project_network": {
          "type": "string"
        },
        "suspended": {
          "type": "boolean",
