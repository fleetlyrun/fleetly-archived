  "paths": {
    "/v1/apps": {
      "get": {
        "operationId": "AppsService_ListApps",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAppsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "列表上限（缺省 100；v0.1 单机规模不做分页游标）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "project",
            "description": "项目收窄（v0.3 W2-S4 可见性过滤，rbac-teams §4.2）：裸名或 `team/project`\n限定形（D-W0-9 解析规则；解析域 = 调用方可见项目集，机具令牌/平台管理\n员 = 全库）。空 = 不收窄（用户面仍按可见项目集过滤）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AppsService"
        ]
      }
    },
