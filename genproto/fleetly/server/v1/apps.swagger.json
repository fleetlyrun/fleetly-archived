    "v1GetScalingPolicyResponse": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "min_replicas": {
          "type": "integer",
          "format": "int32",
          "title": "副本下限（≥1）。"
        },
        "max_replicas": {
          "type": "integer",
          "format": "int32",
