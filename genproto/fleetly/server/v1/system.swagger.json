  ],
  "paths": {
    "/v1/system/acme": {
      "get": {
        "summary": "GetAcmeSettings ACME DNS-01 设置只读面（B 线 W5 设计 §3，D-V3W5-3/4；\nadmin scope——DNS 服务商凭据指纹属平台敏感配置，与 S3 设置同门）。\n凭证只回 fingerprint（sha256 前 8），绝不回明文；同时下发服务端派生的\n通配期望域名集（wildcard=true 时非空）——CLI/Console 展示当前证书\n域名集形态，派生公式与签发面同源（服务端单点）。",
        "operationId": "SystemService_GetAcmeSettings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetAcmeSettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      },
      "put": {
        "summary": "UpdateAcmeSettings 保存 ACME DNS-01 设置（provider + 凭证 + wildcard\n开关）。api_token 为明文只写字段（TLS 传输面承载机密性，持久层\nenvelope 加密）：**留空 = 保留已存凭证**（SMTP 密码同款先例——wildcard\n开关切换不要求重录凭证）；dns_provider=none 恒清空凭证。联动校验\nfail-fast：wildcard=true 须 provider ∈ {dnspod, cloudflare}（422\nE_ACME_WILDCARD_REQUIRES_PROVIDER——通配 SAN 只能 DNS-01 验证）且须\nbase_domain（409 E_ACME_WILDCARD_REQUIRES_BASE_DOMAIN）。保存落审计\nacme.settings_changed（provider/wildcard/凭证有无——零明文；本设置族\n零事件，审计承载）。",
        "operationId": "SystemService_UpdateAcmeSettings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateAcmeSettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1UpdateAcmeSettingsRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/acme/dns:test": {
      "post": {
        "summary": "TestDnsProvider DNS 服务商探针（诚实契约：在 _acme-challenge-test.\n\u003cbase_domain\u003e 建 TXT → 删 TXT 两步真实往返——通过 = 能认证/能写/能删，\nzone 解析在 create 步隐含执行；不是\"能列域名\"级别的浅探测）。可带候选\n凭证（未保存也能测）；两字段全空 = 测已存凭证。探针失败以\nE_ACME_DNS_TEST_FAILED 报错，失败步与底层 provider 错误摘要进信封\ncontext（凭证材料零出现）。",
        "operationId": "SystemService_TestDnsProvider",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TestDnsProviderResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TestDnsProviderRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/backups": {
      "get": {
        "summary": "ListBackups 状态备份台账（T2.22，只读）：热备快照的诚实账（kind/路径/\nsha256/verify_status）。verify_status=failed 的行是红色告警面的一部分\n——台账如实保留失败行，消费方据此判断备份可用性。",
        "operationId": "SystemService_ListBackups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListBackupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      },
      "post": {
        "summary": "TriggerBackup 手动触发一次状态备份（T2.22；deploy scope——写面语义，\n与升级编排 pre_upgrade 快照共用同一同步入口；响应即落账后的台账行，\nverify_status=failed 时调用方必须视为备份失败而非请求失败歧义态）。",
        "operationId": "SystemService_TriggerBackup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TriggerBackupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TriggerBackupRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/ingress": {
