      }
    },
    "/v1/system/registry": {
      "get": {
        "summary": "GetRegistrySettings 平台 registry 凭证设置只读面（IMPL-T1-2/DT-2；\nadmin scope——registry host/用户名/密码指纹属平台敏感配置，与 S3/ACME\n设置同门）。密码只回 fingerprint（sha256 前 8），绝不回明文；未配置\n时 host 为空。",
        "operationId": "SystemService_GetRegistrySettings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetRegistrySettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      },
      "put": {
        "summary": "UpdateRegistrySettings 保存平台 registry 凭证设置（host + 用户名 +\n密码）。语义：host 空 = 清除全部设置；password 留空 = 保留已存密码\n（ACME api_token 同款先例——改主机/用户名不强制重录）。保存落审计\nregistry.updated + 事件 registry.updated（payload 带 host 与指纹，\n凭据材料零出现）。解析失败时部署路径回落本机 inspect（airgap 不回归）。",
        "operationId": "SystemService_UpdateRegistrySettings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateRegistrySettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1UpdateRegistrySettingsRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/s3": {
      "get": {
        "summary": "GetS3Settings 对象存储设置只读面（E3 对象存储 §5.1/E3-2；admin scope\n——端点/桶/凭证指纹属平台敏感配置）。secret 只回 fingerprint（sha256\n前 8），绝不回明文；s3.mode=unset 时其余字段为空。",
        "operationId": "SystemService_GetS3Settings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetS3SettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      },
      "put": {
        "summary": "UpdateS3Settings 全量保存对象存储设置（PUT 语义：请求即新状态，空字段\n即清空——避免「改 mode 残留旧凭证」的静默状态；secret_access_key 为\n明文字段，只写不读，传输面 TLS 承载机密性，持久层 envelope 加密）。\n互斥校验 fail-fast：mode=external 必填四项；mode=rustfs 四项必须为空；\npublic_exposed=true 仅 rustfs 且需 base_domain（E_S3_PUBLIC_REQUIRES_\nBASE_DOMAIN）。保存落审计 + 事件 s3.updated（payload 带模式不带走秘密）。",
        "operationId": "SystemService_UpdateS3Settings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateS3SettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1UpdateS3SettingsRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/s3:test": {
      "post": {
        "summary": "TestS3Connection S3 连接探针（E3 对象存储 §2.1 诚实契约：put→get→\ndelete 一枚探针对象并逐字节比对——通过 = 能认证/能写/能读回，不是 TCP\n探活）。可带候选配置（未保存也能测）；全部候选字段为空 = 测已存配置。\n探针失败以 E_S3_TEST_FAILED 报错，失败步与底层错误摘要进信封 context。",
        "operationId": "SystemService_TestS3Connection",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TestS3ConnectionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TestS3ConnectionRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/status": {
      "get": {
        "operationId": "SystemService_GetSystemStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
