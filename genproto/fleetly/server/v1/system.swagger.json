              "$ref": "#/definitions/v1GetSystemStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "SystemService"
        ]
      }
    }
  },
  "definitions": {
    "v1AcmeSettingsView": {
      "type": "object",
      "properties": {
        "dns_provider": {
          "type": "string",
          "title": "DNS-01 服务商词表：none（缺省，未配置）| dnspod | cloudflare。"
        },
        "credentials_fingerprint": {
          "type": "string",
          "title": "凭证指纹（sha256 前 8 hex），非凭证本体；空 = 未设置。"
        },
        "wildcard": {
          "type": "boolean",
          "title": "通配证书 opt-in 开关（true 时平台证书签\n[*.base, console/ctrl/registry.\u003cbase\u003e]，DNS-01 验证）。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "title": "最近一次保存时刻（从未保存 → 不输出）。"
        },
        "wildcard_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "通配期望域名集的服务端派生实值（wildcard=true 且 base_domain 非空时\n非空；派生公式与签发面同源）。CLI/Console 的「当前证书域集」展示源。"
        },
        "base_domain": {
          "type": "string",
          "title": "平台域名（空 = 单节点形态——通配/平台证书面均不可用）。"
        }
      },
      "title": "AcmeSettingsView 是 acme.* 设置的只读投影。凭证只回 fingerprint（明文\nsha256 前 8 hex；空 = 未设置）——读面永无明文（写面 UpdateAcmeSettings\n承载明文，TLS 传输面 + envelope 持久层）。"
    },
    "v1BackupHealth": {
      "type": "object",
      "properties": {
        "last_backup_id": {
          "type": "string",
          "title": "最近一次备份的台账 ID（= 备份目录名）。"
        },
        "last_kind": {
          "type": "string",
          "title": "最近一次备份的触发类别（daily/pre_upgrade/post_deploy/manual）。"
        },
        "last_backup_at": {
          "type": "string",
          "format": "date-time",
          "title": "最近一次备份的台账落账时刻。"
        },
        "last_verify_status": {
          "type": "string",
          "title": "回读校验结论（verified/failed）。"
        },
        "last_error": {
          "type": "string",
          "title": "失败原因原文（verified 行为空）。"
        }
      },
      "title": "BackupHealth 是系统状态里备份面的明细视图（组件布尔健康的展开：最近\n一次备份的时间与校验结论——「绿色成功但实际没备份」的对立面是让\nverify_status 与时间直接可见）。"
    },
    "v1BackupView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "触发类别：daily / pre_upgrade / post_deploy / manual（历史行可为\nhot/cold）。"
        },
        "path": {
          "type": "string",
          "title": "快照文件路径。"
        },
        "sha256": {
          "type": "string",
          "title": "快照文件 sha256（hex；回读校验对象）。"
        },
        "size_bytes": {
          "type": "string",
          "format": "int64"
        },
        "verify_status": {
          "type": "string",
          "title": "回读校验结论：verified / failed（失败行保留——红色告警面的一部分）。"
        },
        "error": {
          "type": "string",
          "title": "校验失败原因原文（verified 行为空）。"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "台账落账时刻。"
        },
        "upload_status": {
          "type": "string",
          "title": "远端上传结论（E3-3 上传轨）：none（未上传——s3.mode=unset 合法态或\n上传步未执行）/ ok / failed。本地 verify 语义不变（上传失败不回写\nverify_status）。"
        },
        "uploaded_at": {
          "type": "string",
          "format": "date-time",
          "title": "最近一次上传尝试的完成时刻（ok/failed 都记；从未尝试不输出）。"
        },
        "upload_error": {
          "type": "string",
          "title": "上传失败原因摘要（截断上界在存储层；不含 secret——restic env 凭证\n材料禁止进台账/事件/读面）。"
        }
      },
      "title": "BackupView 是状态备份台账行的只读投影（state_backups 表）。path 指向\n备份目录内的快照文件；manifest.json 与其同目录（含 sha256/密钥指纹/\nschema 版本——恢复核对材料，密钥本体绝不入备份目录）。"
    },
    "v1CertLedgerView": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "cert_sha256": {
          "type": "string"
        },
        "cert_not_after": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "CertLedgerView 是证书台账行投影（domains 表 cert 列对照；app 为显示名，\n已删除应用回退显示 app id）。"
    },
    "v1ComponentHealth": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
