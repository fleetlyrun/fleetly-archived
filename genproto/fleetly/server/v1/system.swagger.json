    "/v1/system/nodes/join-guide": {
      "get": {
        "summary": "GetJoinGuide join 向导（E1-8，multi-node §2.3/D-MN-13；admin scope\n——响应含 join token 材料）。base_domain 为空 → E_MULTI_NODE_REQUIRES_\nBASE_DOMAIN（409，D-MN-13：多节点未启用显式拒绝）。服务端生成 join\n命令、按 worker_ip 的精确防火墙放行规则（只生成不自动应用）、DNS\n步骤与完成判据；防火墙规则文本附「--harden-firewall 自动应用维持\nreserved」口径（平台不静默改用户防火墙）。",
        "operationId": "SystemService_GetJoinGuide",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetJoinGuideResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "worker_ip",
            "description": "worker 节点的公网 IP（防火墙规则按它生成精确放行文本；空 = 输出\n规则模板、IP 位以 \u003cworker-ip\u003e 占位）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "manager_addr",
            "description": "manager 可达地址覆盖（advertise 为私网而 worker 跨公网的场景；空 =\n取 swarm advertise addr）。",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/nodes/join-token:rotate": {
      "post": {
        "summary": "RotateJoinToken 轮换 swarm join token（E1-8，D-MN-1：锚定完成后自动\nrotate 把泄露窗口收敛到分钟级；批量场景 manual 后手动执行）。role\n缺省 worker；rotate 后旧 token 立即失效。经底座 swarm 面执行，轮换\n记审计（node.join_token_rotated，§5.3——审计不设事件）。",
        "operationId": "SystemService_RotateJoinToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RotateJoinTokenResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RotateJoinTokenRequest"
            }
          }
        ],
        "tags": [
          "SystemService"
        ]
      }
    },
    "/v1/system/ping": {
      "get": {
        "operationId": "SystemService_Ping",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PingResponse"
            }
