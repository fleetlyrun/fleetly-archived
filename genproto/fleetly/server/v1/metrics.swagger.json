{
  "swagger": "2.0",
  "info": {
    "title": "fleetly/server/v1/metrics.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "MetricsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/metrics/mode": {
      "put": {
        "summary": "SetMetricsMode 切换 metrics 模式（unset | on）：保存即生效——后台收敛\n部署/移除（数据卷保留），deploy scope（同 SetLogsBackend 分级理由）。",
        "operationId": "MetricsService_SetMetricsMode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SetMetricsModeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SetMetricsModeRequest"
            }
          }
        ],
        "tags": [
          "MetricsService"
        ]
      }
    },
    "/v1/metrics/search": {
      "get": {
        "summary": "SearchMetrics 执行 PromQL 区间查询（read scope）：127.0.0.1:8428\n/api/v1/query_range 的规范化投影（label 集 + {t,v} 点集）。",
        "operationId": "MetricsService_SearchMetrics",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SearchMetricsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "description": "PromQL 表达式——**透传**（不转义、不校验语法、无沙箱；VM 裁决）。",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "time_start",
            "description": "时间窗下界；缺省 = 现在回望 1 小时。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "time_end",
            "description": "时间窗上界；缺省 = 现在。",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "step_seconds",
            "description": "步长秒数（缺省 60）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "description": "返回序列数上限（缺省 200，天花板 1000——规范化面截断）。",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "MetricsService"
        ]
      }
    },
    "/v1/metrics/status": {
      "get": {
        "summary": "GetMetricsStatus 托管 metrics 栈状态视图（read scope）：模式 / 三件\n部署态 / 节点上报比 / retention——「N/M nodes reporting」的诚实口径。",
        "operationId": "MetricsService_GetMetricsStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetMetricsStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/v1ErrorResponse"
            }
          }
        },
        "tags": [
          "MetricsService"
        ]
      }
    }
  },
  "definitions": {
    "v1ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "稳定错误码字符串（如 \"E_COMPOSE_INVALID\"），注册表校验只增。"
        },
        "message": {
          "type": "string",
          "title": "人读错误信息（面向运维/集成方，不承诺文案稳定）。"
        },
        "stage": {
          "type": "string",
          "title": "失败所处管线阶段（如 resolve / build / deploy / serve；勿与部署子状态\nphase 混用——该字段 2026-09-20 命名审查由 phase 更名 stage）。"
        },
        "deployment_id": {
          "type": "string",
          "title": "关联的部署 ID（无关联时为空）。"
        },
        "suggestion": {
          "type": "string",
          "title": "可执行的修复建议（面向用户展示）。"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "结构化附加上下文（machine-readable 键值对）。"
        },
        "docs": {
          "type": "string",
          "title": "相关文档 URL（错误码文档锚点）。"
        }
      },
      "title": "ErrorResponse 是 fleetly 对外错误信封的唯一契约定义（发布专项 §2.7、\n架构 D21）：gateway HTTPErrorHandler（阶段 3 落地）将 gRPC 错误统一渲染\n为本结构，snake_case JSON 输出；code 与 T0.2 错误码注册表（唯一真源，\n只增不复用）对齐。"
    },
    "v1GetMetricsStatusResponse": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "title": "生效模式：unset | on（缺省 unset；未显式设置时 mode 已投影为缺省值，\nset 标志区分「缺省生效」）。"
        },
        "mode_set": {
          "type": "boolean",
          "title": "该键是否被显式保存过（false = 缺省态生效）。"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricsComponentView"
          },
          "title": "三件部署态（cAdvisor / node_exporter / VictoriaMetrics 固定序）。"
        },
        "nodes_reporting": {
          "type": "integer",
          "format": "int32",
          "title": "正在向 VM 上报的节点数（up{job=\"fleetly-cadvisor\"} 计数；VM 不可达\n= 0——配合 components 部署态解读，不单独谎报）。"
        },
        "nodes_total": {
          "type": "integer",
          "format": "int32",
          "title": "集群节点总数（观测缓存投影）。"
        },
        "retention_days": {
          "type": "integer",
          "format": "int32",
          "title": "VM -retentionPeriod 对齐天数（config 键 metrics.retention_days）。"
        }
      },
      "title": "GetMetricsStatusResponse 是状态视图（设计 §4.1/§4.2 诚实口径）：mode /\n三件部署态 / 节点上报比（以实际抓到的 cAdvisor 目标数计——跨节点采集\n依赖 overlay 数据面，worker 节点缺席时不谎报 M/M）/ retention。"
    },
    "v1MetricsComponentView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "exists": {
          "type": "boolean",
          "title": "服务是否在位（mode=on 且 false = 后台收敛中——过渡态红面）。"
        },
        "image": {
          "type": "string",
          "title": "实况镜像引用（不在位为空）。"
        }
      },
      "title": "MetricsComponentView 是单件托管服务的部署态投影。"
    },
    "v1MetricsPoint": {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "format": "int64"
        },
        "v": {
          "type": "number",
          "format": "double"
        }
      },
      "title": "MetricsPoint 是单个采样点（t = unix 秒；v = 采样值）。"
    },
    "v1MetricsSeries": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricsPoint"
          }
        }
      },
      "title": "MetricsSeries 是一条时序（label 集原样透传——含 __name__ 原始指标名；\n函数产出的序列无该 label，透传不补造）。"
    },
    "v1SearchMetricsResponse": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricsSeries"
          }
        }
      }
    },
    "v1SetMetricsModeRequest": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        }
      }
    },
    "v1SetMetricsModeResponse": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/v1GetMetricsStatusResponse"
        }
      }
    }
  }
}
